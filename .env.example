# ==============================================================================
# CLIPMAKER CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Рэжым выканання і сховішча (Execution & Storage Mode)
# ------------------------------------------------------------------------------
# RENDER_BACKEND:
#   "local"     - Рэндэрынг у фанавым патоку лакальнага сервера (па змаўчанні для распрацоўкі).
#   "cloud_run" - Выклік Google Cloud Run Jobs (8 vCPU / 16 GiB RAM) для Free Tier у воблаку.
RENDER_BACKEND=local

# STORAGE_BACKEND:
#   "local" - Файлы захоўваюцца лакальна ў data/projects/{id} (па змаўчанні).
#   "s3"    - Файлы загружаюцца і счытваюцца з Cloudflare R2 / S3-сумяшчальнага сховішча.
STORAGE_BACKEND=local

# ------------------------------------------------------------------------------
# 2. Налады Google Cloud Platform і Vertex AI
# ------------------------------------------------------------------------------
# Для Cloud Run Jobs і Secret Manager (праект інфраструктуры):
GCP_PROJECT_ID=clipmaker-prod-2026
GCP_REGION=us-central1
CLOUD_RUN_JOB_NAME=clipmaker-render
# Для Vertex AI (праект бярэцца з JSON-файла сервіснага акаўнта):
GOOGLE_CLOUD_PROJECT=gen-lang-client-0338345659
GOOGLE_CLOUD_LOCATION=global
# АБАВЯЗКОВА для Vertex AI: шлях да лакальнага JSON-файла сервіснага акаўнта
# (на VM дастаўляецца праз Secret Manager у tmpfs /run/clipmaker/vertex-sa.json з правамі 400)
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=/run/clipmaker/vertex-sa.json
# Або лакальна на ПК:
# GOOGLE_APPLICATION_CREDENTIALS=D:\path\to\service-account.json

# ------------------------------------------------------------------------------
# 3. Налады Cloudflare R2 / S3 (для рэжыму STORAGE_BACKEND=s3)
# ------------------------------------------------------------------------------
# Endpoint URL для Cloudflare R2 мае выгляд:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=clipmaker-assets

# ------------------------------------------------------------------------------
# 4. Gemini API & Мадэлі (Google AI Studio)
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEXAI=true
TRANSCRIBE_LANGUAGE_CODES=be-BY
GENAI_TEXT_MODEL=gemini-2.0-flash
GENAI_IMAGE_MODEL=gemini-2.5-flash-image
GENAI_SUBTITLE_MODEL=gemini-2.0-flash
GENAI_TEXT_MODE=standard
GENAI_IMAGE_MODE=standard
GENAI_IMAGE_RPM=5

# ------------------------------------------------------------------------------
# 5. Supabase (База дадзеных, Auth і RLS)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
